# Git
.git
.gitignore

# Python 缓存
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.codex/
harness/
openspec/

# 测试与样本（体积大，运行时不需要）
tests/
test_wav/
*.wav
!model/**/*.wav
*.pcm
*.mp3

# 日志与运行时产物
logs/
*.log
asr_stats.json
asr_service.log

# IDE / 本地配置
config*.toml
.idea/
.vscode/
.claude/
.env
*.pem
*.key
*.p12
*.pfx
*.swp

# 模型权重需要打入镜像，不要排除 model/ 内的 *.bin / *.safetensors。

# 构建产物（由 obfuscator 阶段生成）
*.so
*.c

# 仅 registry client 固定 wheel 属于镜像输入，其他本地 wheel 不得进入 context。
wheel/*.whl
!wheel/algorithm_operator_registry_client-0.1.0-py3-none-any.whl

# 文档与杂项（非运行必需，可按需保留 README）
# README.md
model/speaker-diarization-3.1/
model/segmentation-3.0/
model/wespeaker-voxceleb-resnet34-LM/
model/bert-base-chinese/
model/bert_output/
