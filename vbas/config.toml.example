# 图片根目录。旧同步任务和相对路径图片读取会使用该目录。
IMAGE_ROOT = "/mnt/ias-images"

# 结果图保存配置。SAVE_RESULT_IMAGE=0 表示不额外保存画框结果图。
RESULT_IMAGE_ROOT = "/data/result_images"
SAVE_RESULT_IMAGE = 0

# 服务进程配置。6.0 建议一个 TIAS 实例对应一个端口和一个准入队列。
INSTANCE_COUNT = 1
WORKERS_PER_INSTANCE = 1

# 主模型推理设备。CPU 环境使用 "cpu"，NVIDIA GPU 环境可配置为 "0"。
GPU_ID = "cpu"

[platform]
# 本地默认不主动向调度平台注册；受控部署配置将其设置为 true。
registration_enabled = false
control_service_url = ""
heartbeat_interval_seconds = 5
# 学生和教师能力共享的单实例容量，按 HTTP batch 计数。
max_concurrent_requests = 1024

[runtime]
# 本地示例允许 CPU；GPU 部署配置显式设为 true。
require_gpu = false

[TIAS]
# TIAS 实例身份和对外访问地址。
InstanceId = "tias-8981"
BaseUrl = "http://127.0.0.1:8981"

# 外部视觉编排服务的兼容注册入口；字段名为历史协议，暂不改名。
AiQualityBaseUrl = "http://127.0.0.1:9000"

# 是否暴露旧 IAS 同步任务接口。
TiasExposeLegacySyncTasks = false

# 本地推理按 HTTP batch 计数；每个 batch 最多 8 图但只占一个运行槽位。
MaxConcurrentOfflineBatches = 1
# 在线请求并发数，按 HTTP 请求计数。
MaxConcurrentOnlineRequests = 24
# 在线 FIFO 等待队列上限。
MaxQueueOnlineSize = 24

# 注册和心跳配置。
HeartbeatIntervalSeconds = 5
HeartbeatTimeoutSeconds = 15
RegisterRetryIntervalSeconds = 5

# HTTP 服务配置。
Host = "0.0.0.0"
Port = 8981

[Person_Thresd]
Head = 0.25
Top_Head = 0.1
Hat = 0.1
Headphones = 0.1
Shoulder = 0.1

[Face_Thresd]
face = 0.1

[Student_Thresd]
phone = 0.7
hand = 0.99
sleep = 0.5
stand = 0.99
read = 0.5

[Teacher_Behavior_Thresd]
MergeIoU = 0.8
SubjectClusterIoU = 0.45
ImageSize = 640
sit = 0.4
stand = 0.4
bbwriting = 0.25
teach = 0.25
KeepOnlyMainSubject = true
MainSubjectStrategy = "posture_confidence"
PostureConflictRatio = 0.10
PostureConflictDefault = "stand"
ForcePostureWhenMissing = true

[Teacher_Head_Pose]
Enabled = false
DirectMHPRoot = "app/vendor/DirectMHP"
DirectMHPWeights = "models/cmu_m_1280_e200_t40_lw010_best.pt"
DirectMHPData = "models/cmu_panoptic_coco.yaml"
Device = "cpu"
ImageSize = 1280
ConfThres = 0.35
IouThres = 0.45
CropScale = 1.35
SideYawThreshold = 20.0
DownPitchThreshold = 20.0

[ModelProtection]
# 模型静态加密开关。false 时按明文模型路径加载；true 时从 EncryptedModelRoot 解密 .enc 模型。
Enabled = false
# 加密模型目录。容器部署建议只读挂载到该路径。
EncryptedModelRoot = "/workspace/models-encrypted"
# 临时明文模型目录。建议使用内存盘，权限会设置为 0700。
DecryptedTempRoot = "/dev/shm/tias-models"
# 模型密钥运行期副本。secure entrypoint 会从只读挂载源复制到该路径，应用读取后删除副本。
KeyFile = "/dev/shm/tias_model_key"
# 模型加载成功后是否删除临时明文文件。
CleanupAfterLoad = true
