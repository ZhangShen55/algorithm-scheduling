FROM nvidia/cuda:11.3.1-cudnn8-runtime-ubuntu20.04

LABEL authors="SeaCraft"

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

RUN apt-get update && \
    apt-get install -y \
        python3.8 \
        python3.8-distutils \
        python3.8-dev \
        python3-pip \
        build-essential \
        git \
        jq \
        curl \
        libgl1-mesa-glx \
        libglib2.0-0 \
        libsm6 \
        libxrender1 \
        libxext6 \
        libfontconfig1 \
        libice6 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3.8 /usr/bin/python3 && \
    ln -sf /usr/bin/python3.8 /usr/bin/python

RUN curl https://bootstrap.pypa.io/pip/3.8/get-pip.py | python3.8 && \
    ln -sf /usr/local/bin/pip3.8 /usr/bin/pip && \
    python -m pip install --upgrade pip

RUN pip install torch==1.12.1+cu113 torchvision==0.13.1+cu113 torchaudio==0.12.1 \
    --extra-index-url https://download.pytorch.org/whl/cu113 \
    -i https://mirrors.aliyun.com/pypi/simple/

WORKDIR /workspace

COPY ./requirements_cuda113.txt ./requirements_cuda113.txt
ARG OPERATOR_REGISTRY_CLIENT_WHEEL=algorithm_operator_registry_client-0.1.0-py3-none-any.whl
COPY wheel/${OPERATOR_REGISTRY_CLIENT_WHEEL} /tmp/wheels/${OPERATOR_REGISTRY_CLIENT_WHEEL}
COPY ./app ./app
COPY ./config.toml ./config.toml
COPY ./models ./models
COPY ./models-encrypted ./models-encrypted
COPY ./docker/start.sh ./docker/start.sh
COPY ./scripts/build_cython_modules.py ./scripts/build_cython_modules.py

RUN pip install --no-deps /tmp/wheels/${OPERATOR_REGISTRY_CLIENT_WHEEL} && \
    pip install -i https://mirrors.aliyun.com/pypi/simple/ -r requirements_cuda113.txt

ENV PYTHONUNBUFFERED=1 \
    CONFIG_PATH=/workspace/config.toml

RUN chmod +x docker/start.sh
ARG PROTECT_SOURCE=0
RUN set -e; \
    if [ "$PROTECT_SOURCE" = "1" ]; then \
        python scripts/build_cython_modules.py \
          --root /workspace \
          --package app/api \
          --package app/core \
          --package app/services \
          --package app/schemas \
          --keep-source app/__init__.py \
          --keep-source app/main.py \
          --keep-source app/core/__init__.py \
          --keep-source app/api/__init__.py \
          --keep-source app/services/__init__.py \
          --keep-source app/schemas/__init__.py \
          --exclude-glob 'app/vendor/**' \
          --exclude-glob 'models/**' \
          --remove-sources; \
        rm -rf build; \
        find /workspace -type d -name '__pycache__' -prune -exec rm -rf {} +; \
    fi

EXPOSE 8981
CMD ["/bin/bash", "-c", "docker/start.sh"]
