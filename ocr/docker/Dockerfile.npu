ARG NPU_BASE_IMAGE
FROM ${NPU_BASE_IMAGE}

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

WORKDIR /app

COPY requirements.txt requirements.npu.txt ./
ARG OPERATOR_REGISTRY_CLIENT_WHEEL=algorithm_operator_registry_client-0.2.0-py3-none-any.whl
COPY wheel/${OPERATOR_REGISTRY_CLIENT_WHEEL} /tmp/wheels/${OPERATOR_REGISTRY_CLIENT_WHEEL}
RUN python -m pip install --no-deps /tmp/wheels/${OPERATOR_REGISTRY_CLIENT_WHEEL} \
    && python -m pip install --no-cache-dir -r requirements.npu.txt

COPY app ./app
COPY models ./models
COPY scripts/verify_models.py ./scripts/verify_models.py

RUN python scripts/verify_models.py && mkdir -p /app/logs

EXPOSE 8866

CMD ["python", "-m", "app.main"]
