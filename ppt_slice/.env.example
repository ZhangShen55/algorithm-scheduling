# Environment Variables
# 应用配置
APP_NAME=Video PPT Slice Service
APP_VERSION=V1.0.0_20260417
DEBUG=False
HOST=0.0.0.0
PORT=9001

# 任务配置
MAX_CONCURRENT_TASKS=15
MAX_QUEUE_SIZE=25
MIN_FRAMES_OK=5

# 共享结果根目录（容器部署建议挂载为 /data/result）
RESULT_ROOT=/data/result

# 相似度阈值
DEFAULT_CONTIGUOUS_SIMILARITY=0.99
DEFAULT_SAVED_SIMILARITY=0.98

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FILE=app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
