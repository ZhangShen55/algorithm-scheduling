# Merge these entries into control_service/config.toml on the platform host.
# The value must exactly match the remote operator's PLATFORM_SERVICE_URL.
[operator_registry.trusted_service_urls]
vbas-29-12-gpu0 = "http://192.168.29.12:28981"
screen-det-29-12-gpu1 = "http://192.168.29.12:28880"

# Add one entry per remote instance. Do not use a Docker-only service name.
