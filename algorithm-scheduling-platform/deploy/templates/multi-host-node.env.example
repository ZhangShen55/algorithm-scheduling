# Copy this file outside Git for each GPU host and source it before Compose.
# This example is for the second observation-only GPU host.
PLATFORM_HOST_ID=192.168.29.12
GPU_EXPORTER_HOST_ID=192.168.29.12
GPU_METRICS_BIND_HOST=0.0.0.0
GPU_METRICS_IMAGE=algorithm-gpu-metrics-exporter:local

# Remote operator values for the first deployed instance. Each additional
# instance sets its own identity and GPU in Compose.
PLATFORM_INSTANCE_ID=vbas-29-12-gpu0
PLATFORM_SERVICE_URL=http://192.168.29.12:28981
PLATFORM_INSTANCE_LABELS='{"host_id":"192.168.29.12","gpu":"0"}'

# The platform host exports these directories through NFS. The container paths
# remain unchanged on every host.
COURSE_ROOT=/data/course
RESULT_ROOT=/data/result
