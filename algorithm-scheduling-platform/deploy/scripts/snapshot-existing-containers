#!/usr/bin/env bash
set -euo pipefail

if [[ "$#" -ne 1 ]]; then
  printf 'usage: %s OUTPUT_JSONL\n' "$0" >&2
  exit 64
fi

output_path="$1"
output_directory="$(dirname "$output_path")"
[[ ! -L "$output_path" ]] || {
  printf 'snapshot: refusing symlink output: %s\n' "$output_path" >&2
  exit 1
}
mkdir -p "$output_directory"
temporary_path="$(mktemp "${output_directory}/.existing-containers.XXXXXX")"
chmod 600 "$temporary_path"
trap 'rm -f "$temporary_path"' EXIT
container_ids="$(docker ps -aq)" || {
  printf 'snapshot: failed to list containers\n' >&2
  exit 1
}

while IFS= read -r container_id; do
  [[ -n "$container_id" ]] || continue
  docker inspect "$container_id" | python3 -c '
import json
import re
import sys

payload = json.load(sys.stdin)
if not isinstance(payload, list) or len(payload) != 1 or not isinstance(payload[0], dict):
    raise SystemExit("docker inspect returned an unexpected payload")
item = payload[0]
if not re.fullmatch(r"[0-9a-f]{12,64}", item.get("Id", "")):
    raise SystemExit("docker inspect returned an invalid container ID")
config = item["Config"]
host = item["HostConfig"]
labels = config.get("Labels") or {}
mounts = [
    {
        "type": mount.get("Type"),
        "source": mount.get("Source"),
        "destination": mount.get("Destination"),
        "mode": mount.get("Mode"),
        "rw": mount.get("RW"),
        "propagation": mount.get("Propagation"),
    }
    for mount in item.get("Mounts", [])
]
record = {
    "container_id": item["Id"],
    "name": item["Name"].removeprefix("/"),
    "image_ref": config["Image"],
    "image_id": item["Image"],
    "state": item["State"]["Status"],
    "labels": labels,
    "ports": host.get("PortBindings") or {},
    "mounts": mounts,
    "restart_policy": host.get("RestartPolicy") or {},
    "compose_project": labels.get("com.docker.compose.project", ""),
}
print(json.dumps(record, sort_keys=True, separators=(",", ":")))
' >>"$temporary_path"
  printf 'snapshot: %s: recorded\n' "$container_id"
done <<<"$container_ids"

python3 - "$temporary_path" "$output_path" <<'PY'
import os
import sys
from pathlib import Path

source = Path(sys.argv[1])
target = Path(sys.argv[2])
if target.is_symlink():
    raise SystemExit(f"snapshot: refusing symlink output: {target}")
with source.open("rb") as stream:
    os.fsync(stream.fileno())
os.replace(source, target)
directory_fd = os.open(target.parent, os.O_RDONLY)
try:
    os.fsync(directory_fd)
finally:
    os.close(directory_fd)
PY
trap - EXIT
printf 'snapshot: complete: %s\n' "$output_path"
