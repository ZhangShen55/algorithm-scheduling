#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
import re
import stat
import sys
from pathlib import Path, PurePosixPath


def fail(message: str) -> None:
    print(f"runtime-secrets: FAIL: {message}", file=sys.stderr)
    raise SystemExit(1)


def secret_metadata(source: Path, secret_id: str) -> os.stat_result:
    absolute = source.absolute()
    if not absolute.is_absolute() or any(part in {"", ".", ".."} for part in source.parts):
        fail(f"运行时密钥路径无效：{secret_id}")
    directory_flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(
        os, "O_NOFOLLOW", 0
    )
    file_flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    descriptors: list[int] = []
    try:
        current = os.open(absolute.anchor, directory_flags)
        descriptors.append(current)
        parent_parts = absolute.parts[1:-1]
        for index, part in enumerate(parent_parts):
            try:
                current = os.open(part, directory_flags, dir_fd=current)
            except OSError:
                fail(f"运行时密钥父目录包含符号链接或不可安全访问：{secret_id}")
            descriptors.append(current)
            if index == len(parent_parts) - 1:
                metadata = os.fstat(current)
                if metadata.st_uid != os.geteuid():
                    fail(f"运行时密钥配置目录必须由当前用户持有：{secret_id}")
                if stat.S_IMODE(metadata.st_mode) & 0o022:
                    fail(f"运行时密钥配置目录权限禁止组或其他用户写入：{secret_id}")
        try:
            descriptor = os.open(absolute.name, file_flags, dir_fd=current)
        except OSError:
            fail(f"运行时密钥缺失、为符号链接或不可安全访问：{secret_id}")
        descriptors.append(descriptor)
        return os.fstat(descriptor)
    finally:
        for descriptor in reversed(descriptors):
            os.close(descriptor)


parser = argparse.ArgumentParser()
parser.add_argument(
    "--secret",
    action="append",
    default=[],
    metavar="ID=CONTAINER_TARGET=HOST_SOURCE",
)
arguments = parser.parse_args()
if not arguments.secret:
    print("runtime-secrets: PASS: no runtime secrets requested for plain model mode")
    raise SystemExit(0)

seen_ids: set[str] = set()
seen_targets: set[str] = set()
for binding in arguments.secret:
    values = binding.split("=", 2)
    if len(values) != 3:
        fail("secret binding must be ID=CONTAINER_TARGET=HOST_SOURCE")
    secret_id, target_value, source_value = values
    if not re.fullmatch(r"[a-z][a-z0-9_]{0,63}", secret_id):
        fail("secret ID must use lowercase letters, digits and underscores")
    target = PurePosixPath(target_value)
    if not target.is_absolute() or target.parent != PurePosixPath("/run/secrets"):
        fail("container secret target must be directly below /run/secrets")
    if secret_id in seen_ids or target.as_posix() in seen_targets:
        fail("duplicate secret ID or container target")
    seen_ids.add(secret_id)
    seen_targets.add(target.as_posix())
    metadata = secret_metadata(Path(source_value), secret_id)
    if not stat.S_ISREG(metadata.st_mode):
        fail(f"runtime secret must be a regular file for ID {secret_id}")
    if stat.S_IMODE(metadata.st_mode) != 0o600:
        fail(f"runtime secret must have exact 0600 mode for ID {secret_id}")
    if metadata.st_uid != os.geteuid():
        fail(f"runtime secret owner must match the current user for ID {secret_id}")
    print(f"runtime-secrets: OK: id={secret_id} target={target.as_posix()}")

print("runtime-secrets: PASS")
