#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
import re
import stat
import sys
from pathlib import Path, PurePosixPath


def fail(message: str) -> None:
    print(f"runtime-secrets: FAIL: {message}", file=sys.stderr)
    raise SystemExit(1)


parser = argparse.ArgumentParser()
parser.add_argument(
    "--secret",
    action="append",
    default=[],
    metavar="ID=CONTAINER_TARGET=HOST_SOURCE",
)
arguments = parser.parse_args()
if not arguments.secret:
    print("runtime-secrets: PASS: no runtime secrets requested for plain model mode")
    raise SystemExit(0)

seen_ids: set[str] = set()
seen_targets: set[str] = set()
for binding in arguments.secret:
    values = binding.split("=", 2)
    if len(values) != 3:
        fail("secret binding must be ID=CONTAINER_TARGET=HOST_SOURCE")
    secret_id, target_value, source_value = values
    if not re.fullmatch(r"[a-z][a-z0-9_]{0,63}", secret_id):
        fail("secret ID must use lowercase letters, digits and underscores")
    target = PurePosixPath(target_value)
    if not target.is_absolute() or target.parent != PurePosixPath("/run/secrets"):
        fail("container secret target must be directly below /run/secrets")
    if secret_id in seen_ids or target.as_posix() in seen_targets:
        fail("duplicate secret ID or container target")
    seen_ids.add(secret_id)
    seen_targets.add(target.as_posix())
    source = Path(source_value)
    try:
        metadata = source.lstat()
    except OSError:
        fail(f"runtime secret is missing for ID {secret_id}")
    if not stat.S_ISREG(metadata.st_mode) or source.is_symlink():
        fail(f"runtime secret must be a regular file for ID {secret_id}")
    if stat.S_IMODE(metadata.st_mode) != 0o600:
        fail(f"runtime secret must have exact 0600 mode for ID {secret_id}")
    if metadata.st_uid != os.geteuid():
        fail(f"runtime secret owner must match the current user for ID {secret_id}")
    print(f"runtime-secrets: OK: id={secret_id} target={target.as_posix()}")

print("runtime-secrets: PASS")
