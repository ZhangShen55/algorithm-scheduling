#!/usr/bin/env bash
set -euo pipefail

platform_root="$(cd "$(dirname "$0")/../.." && pwd)"
deploy_root="${platform_root}/deploy"
preflight_checks="${deploy_root}/scripts/preflight_checks.py"
deployment_contracts="${deploy_root}/scripts/deployment_contracts.py"
if [[ -x "${platform_root}/.venv/bin/python" ]]; then
  preflight_python="${platform_root}/.venv/bin/python"
else
  preflight_python="python3"
fi

fail() {
  printf 'preflight: FAIL: %s\n' "$*" >&2
  exit 1
}

normalize_git_sha() {
  local value="$1"
  [[ "$value" =~ ^[0-9a-fA-F]{40}$ ]] || \
    fail "Git SHA is required and must be a full 40-character hexadecimal revision"
  NORMALIZED_GIT_SHA="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')"
}

run_host() {
operator_registry_token="${OPERATOR_REGISTRY_TOKEN:-}"
[[ -n "$operator_registry_token" ]] || fail "OPERATOR_REGISTRY_TOKEN is required"
[[ "$operator_registry_token" != "local-development-registry-token" ]] || fail \
  "development registry token is forbidden for canonical deployment"

min_root_free_gib="${MIN_ROOT_FREE_GIB:-100}"
[[ "$min_root_free_gib" =~ ^[0-9]+$ ]] || fail "MIN_ROOT_FREE_GIB must be a non-negative integer"
root_available_kib="$(df -Pk / | awk 'NR == 2 {print $4}')"
[[ "$root_available_kib" =~ ^[0-9]+$ ]] || fail "cannot determine root disk free space"
"$preflight_python" "$deployment_contracts" root-disk \
  --available-kib "$root_available_kib" --minimum-gib "$min_root_free_gib" || exit 1
minimum_kib=$((min_root_free_gib * 1024 * 1024))
(( root_available_kib >= minimum_kib )) || fail \
  "root disk has ${root_available_kib} KiB free; ${min_root_free_gib} GiB required"
printf 'preflight: OK: root disk free space\n'

host_architecture="$(uname -m)"
"$preflight_python" "$deployment_contracts" architecture \
  --host "$host_architecture" || exit 1
[[ "$host_architecture" == "x86_64" ]] || fail "server architecture must be x86_64"
printf 'preflight: OK: x86_64 architecture\n'

command -v docker >/dev/null 2>&1 || fail "docker command is unavailable"
docker version >/dev/null 2>&1 || fail "Docker daemon is unavailable"
docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is unavailable"
printf 'preflight: OK: Docker and Compose\n'

gpu_image="${PREFLIGHT_GPU_IMAGE:-nvidia/cuda:12.4.1-base-ubuntu22.04}"
if ! gpu_output="$(docker run --rm --gpus all --entrypoint nvidia-smi "$gpu_image" \
  --query-gpu=index,uuid --format=csv,noheader,nounits)"; then
  fail "NVIDIA container runtime could not expose GPUs"
fi
"$preflight_python" "$preflight_checks" gpus <<<"$gpu_output" || exit 1
printf 'preflight: OK: NVIDIA runtime exposes exactly 3 GPUs\n'

course_root="${COURSE_ROOT:-/data/course}"
result_root="${RESULT_ROOT:-/data/result}"
"$preflight_python" "$deployment_contracts" writable-directory \
  "$course_root" "$result_root" || exit 1
for required_directory in "$course_root" "$result_root"; do
  [[ -d "$required_directory" ]] || fail "required directory is missing: ${required_directory}"
  python3 - "$required_directory" <<'PY' || fail \
    "required directory is not writable by the preflight execution identity: ${required_directory}"
import os
import sys
import uuid
from pathlib import Path

directory = Path(sys.argv[1])
probe = directory / f".preflight-write-probe-{uuid.uuid4().hex}"
fd = os.open(probe, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
try:
    os.write(fd, b"probe")
    os.fsync(fd)
finally:
    os.close(fd)
os.unlink(probe)
directory_fd = os.open(directory, os.O_RDONLY)
try:
    os.fsync(directory_fd)
finally:
    os.close(directory_fd)
PY
done
printf 'preflight: OK: course and result directories are writable\n'

log_root="${LOG_ROOT:-}"
if [[ -n "$log_root" ]]; then
  minimum_log_free_gib="${MIN_LOG_FREE_GIB:-1}"
  [[ "$minimum_log_free_gib" =~ ^[0-9]+$ ]] || fail \
    "MIN_LOG_FREE_GIB must be a non-negative integer"
  "$preflight_python" "$deployment_contracts" logging-root "$log_root" \
    --minimum-free-gib "$minimum_log_free_gib" || exit 1
  printf 'preflight: OK: optional host log root is safe and writable\n'
fi

platform_compose="${deploy_root}/docker-compose.platform.yml"
operator_compose="${deploy_root}/docker-compose.operators.yml"
if ! platform_compose_json="$(docker compose --project-directory "$deploy_root" \
  -f "$platform_compose" config --format json)"; then
  fail "platform Compose rendering failed"
fi
if ! operator_compose_json="$(docker compose --project-directory "$deploy_root" \
  -f "$operator_compose" --profile '*' config --format json)"; then
  fail "operator Compose rendering failed"
fi
"$preflight_python" "$deployment_contracts" operator-compose-yaml \
  "$operator_compose" || exit 1
if ! required_ports="$("$preflight_python" "$preflight_checks" host-compose \
  --course-root "$course_root" --result-root "$result_root" \
  <(printf '%s' "$platform_compose_json") \
  <(printf '%s' "$operator_compose_json"))"; then
  exit 1
fi
printf 'preflight: OK: authoritative Compose definitions\n'

if ! all_container_ids="$(docker ps -aq)"; then
  fail "existing container enumeration failed"
fi
if [[ -n "$all_container_ids" ]]; then
  read -r -a all_container_array <<<"$(printf '%s\n' "$all_container_ids" | tr '\n' ' ')"
  if ! all_container_inspection="$(docker inspect "${all_container_array[@]}")"; then
    fail "existing container inspection failed"
  fi
else
  all_container_inspection='[]'
fi
"$preflight_python" "$deployment_contracts" existing-containers \
  <(printf '%s' "$all_container_inspection") \
  <(printf '%s' "$platform_compose_json") \
  <(printf '%s' "$operator_compose_json") || exit 1
printf 'preflight: OK: no unknown algorithm-prefixed containers\n'

authorized_endpoints="${AUTHORIZED_OCCUPIED_ENDPOINTS:-}"
read -r -a authorized_endpoint_array <<<"$authorized_endpoints"
command -v ss >/dev/null 2>&1 || fail "ss socket inspection command is unavailable"
if ! socket_output="$(ss -H -ltn 2>/dev/null)"; then
  fail "ss socket inspection failed"
fi
host_socket_arguments=(host-sockets)
for required_port in $required_ports; do
  [[ "$required_port" =~ ^[0-9]+$ ]] || fail "invalid required port: ${required_port}"
  host_socket_arguments+=(--required-port "$required_port")
done
for authorized_endpoint in "${authorized_endpoint_array[@]}"; do
  host_socket_arguments+=(--authorized-endpoint "$authorized_endpoint")
done
if ! "$preflight_python" "$preflight_checks" "${host_socket_arguments[@]}" \
  <<<"$socket_output"; then
  fail "host socket inspection output validation failed"
fi
printf 'preflight: OK: required ports have no unauthorized occupants\n'

[[ -z "$(git status --porcelain)" ]] || fail "Git working tree is not clean"
current_git_sha="$(git rev-parse HEAD)"
if [[ -z "${EXPECTED_GIT_SHA:-}" ]]; then
  if [[ "${ALLOW_UNPINNED_GIT:-false}" == "true" ]]; then
    printf 'preflight: WARNING: ALLOW_UNPINNED_GIT=true; Git revision is not pinned\n' >&2
  else
    fail "EXPECTED_GIT_SHA is required and must be a full 40-character hex SHA"
  fi
elif [[ ! "$EXPECTED_GIT_SHA" =~ ^[0-9a-fA-F]{40}$ ]]; then
  fail "EXPECTED_GIT_SHA must be a full 40-character hex SHA"
elif [[ "$current_git_sha" != "$EXPECTED_GIT_SHA" ]]; then
  fail "current Git SHA ${current_git_sha} does not match EXPECTED_GIT_SHA ${EXPECTED_GIT_SHA}"
fi
printf 'preflight: OK: Git state %s\n' "$current_git_sha"
printf 'preflight host: PASS\n'
printf 'preflight: PASS\n'
}

run_runtime() {
  runtime_git_sha=""
  runtime_git_sha_set=false
  while (( $# > 0 )); do
    case "$1" in
      --git-sha)
        (( $# >= 2 )) || fail "--git-sha requires a value"
        [[ "$2" != --* ]] || fail "--git-sha requires a value"
        [[ "$runtime_git_sha_set" == "false" ]] || fail "--git-sha cannot be repeated"
        runtime_git_sha="$2"
        runtime_git_sha_set=true
        shift 2
        ;;
      --git-sha=*)
        [[ "$runtime_git_sha_set" == "false" ]] || fail "--git-sha cannot be repeated"
        runtime_git_sha="${1#*=}"
        runtime_git_sha_set=true
        shift
        ;;
      *)
        fail "usage: preflight runtime [--git-sha SHA]"
        ;;
    esac
  done
  if [[ "$runtime_git_sha_set" == "true" ]]; then
    normalize_git_sha "$runtime_git_sha"
  else
    normalize_git_sha "${EXPECTED_GIT_SHA:-}"
  fi
  expected_git_sha="$NORMALIZED_GIT_SHA"

  command -v docker >/dev/null 2>&1 || fail "docker command is unavailable"
  docker version >/dev/null 2>&1 || fail "Docker daemon is unavailable"
  docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is unavailable"

  platform_compose="${deploy_root}/docker-compose.platform.yml"
  platform_services=(
    control-service
    orchestrator-service
    vision-orchestrator-service
    online-gateway-service
  )
  if ! running_output="$(docker compose --project-directory "$deploy_root" \
    -f "$platform_compose" ps --no-trunc --status running -q \
    "${platform_services[@]}")"; then
    fail "platform running container inspection failed"
  fi
  read -r -a running_containers <<<"$(printf '%s\n' "$running_output" | tr '\n' ' ')"
  (( ${#running_containers[@]} == ${#platform_services[@]} )) || fail \
    "platform services require exactly ${#platform_services[@]} running containers; found ${#running_containers[@]}"
  if ! inspection_json="$(docker inspect "${running_containers[@]}")"; then
    fail "docker inspect failed for platform containers"
  fi
  service_args=()
  for service_name in "${platform_services[@]}"; do
    service_args+=(--service "$service_name")
  done
  if ! image_id_output="$("$preflight_python" "$preflight_checks" container-images \
    "${service_args[@]}" <(printf '%s' "$inspection_json"))"; then
    exit 1
  fi
  read -r -a image_ids <<<"$image_id_output"
  (( ${#image_ids[@]} > 0 )) || fail "platform image selection is empty"
  if ! image_inspection_json="$(docker image inspect "${image_ids[@]}")"; then
    fail "docker image inspect failed for platform images"
  fi
  image_args=()
  for image_id in "${image_ids[@]}"; do
    image_args+=(--image-id "$image_id")
  done
  "$preflight_python" "$preflight_checks" image-revisions \
    --git-sha "$expected_git_sha" "${image_args[@]}" \
    <(printf '%s' "$image_inspection_json") || exit 1
  printf 'preflight: OK: platform image revisions\n'

  control_readiness_url="${CONTROL_READINESS_URL:-http://127.0.0.1:18100/ops/readiness}"
  orchestrator_readiness_url="${ORCHESTRATOR_READINESS_URL:-http://127.0.0.1:18101/ops/readiness}"
  readiness_timeout="${PREFLIGHT_READINESS_TIMEOUT_SECONDS:-5}"
  "$preflight_python" "$preflight_checks" readiness --timeout "$readiness_timeout" \
    "$control_readiness_url" "$orchestrator_readiness_url" || exit 1
  printf 'preflight: OK: control and orchestrator readiness\n'

  postgres_user="${PREFLIGHT_POSTGRES_USER:-algorithm}"
  postgres_database="${PREFLIGHT_POSTGRES_DATABASE:-algorithm}"
  table_query="SELECT c.relname, pg_catalog.obj_description(c.oid, 'pg_class') FROM pg_catalog.pg_class AS c JOIN pg_catalog.pg_namespace AS n ON n.oid = c.relnamespace WHERE n.nspname = current_schema() AND c.relkind = 'r' ORDER BY c.relname"
  column_query="SELECT c.relname, a.attname, pg_catalog.col_description(c.oid, a.attnum) FROM pg_catalog.pg_class AS c JOIN pg_catalog.pg_namespace AS n ON n.oid = c.relnamespace JOIN pg_catalog.pg_attribute AS a ON a.attrelid = c.oid WHERE n.nspname = current_schema() AND c.relkind = 'r' AND a.attnum > 0 AND NOT a.attisdropped ORDER BY c.relname, a.attnum"
  index_query="SELECT tablename, indexname FROM pg_catalog.pg_indexes WHERE schemaname = current_schema() ORDER BY tablename, indexname"
  psql_base=(docker compose --project-directory "$deploy_root" -f "$platform_compose" \
    exec -T -e "PGOPTIONS=-c default_transaction_read_only=on" postgres psql \
    --no-psqlrc --set=ON_ERROR_STOP=1 --csv --tuples-only \
    --username "$postgres_user" --dbname "$postgres_database" --command)
  if ! table_catalog="$("${psql_base[@]}" "$table_query")"; then
    fail "PostgreSQL table catalog inspection failed"
  fi
  if ! column_catalog="$("${psql_base[@]}" "$column_query")"; then
    fail "PostgreSQL column catalog inspection failed"
  fi
  if ! index_catalog="$("${psql_base[@]}" "$index_query")"; then
    fail "PostgreSQL index catalog inspection failed"
  fi
  "$preflight_python" "$preflight_checks" database \
    <(printf '%s\n' "$table_catalog") \
    <(printf '%s\n' "$column_catalog") \
    <(printf '%s\n' "$index_catalog") || exit 1
  printf 'preflight: OK: PostgreSQL schema, comments, and indexes\n'

  kafka_bootstrap="${PREFLIGHT_KAFKA_BOOTSTRAP:-localhost:9092}"
  if ! topic_metadata="$(docker compose --project-directory "$deploy_root" \
    -f "$platform_compose" exec -T kafka /opt/kafka/bin/kafka-topics.sh \
    --bootstrap-server "$kafka_bootstrap" --describe)"; then
    fail "Kafka topic inspection failed"
  fi
  orchestrator_config="${ORCHESTRATOR_CONFIG_PATH:-${platform_root}/../orchestrator_service/config.toml}"
  "$preflight_python" "$preflight_checks" topics --config "$orchestrator_config" \
    <<<"$topic_metadata" || exit 1
  printf 'preflight: OK: Kafka topics\n'
  printf 'preflight runtime: PASS\n'
}

run_operators() {
  full_requested=false
  operator_git_sha=""
  operator_git_sha_set=false
  selection_args=()
  registration_args=()
  while (( $# > 0 )); do
    case "$1" in
      --full)
        [[ "$full_requested" == "false" ]] || fail "--full cannot be repeated"
        (( ${#selection_args[@]} == 0 )) || fail "--full and --profile are mutually exclusive"
        full_requested=true
        shift
        ;;
      --profile)
        (( $# >= 2 )) || fail "--profile requires a value"
        [[ "$2" != --* ]] || fail "--profile requires a value"
        [[ "$full_requested" == "false" ]] || fail "--full and --profile are mutually exclusive"
        selection_args+=(--profile "$2")
        shift 2
        ;;
      --profile=*|--instance|--instance=*|--expected-compose|--expected-compose=*)
        fail "operators preflight only supports the authoritative full/profile selection"
        ;;
      --git-sha)
        (( $# >= 2 )) || fail "--git-sha requires a value"
        [[ "$2" != --* ]] || fail "--git-sha requires a value"
        [[ "$operator_git_sha_set" == "false" ]] || fail "--git-sha cannot be repeated"
        operator_git_sha="$2"
        operator_git_sha_set=true
        shift 2
        ;;
      --git-sha=*)
        [[ "$operator_git_sha_set" == "false" ]] || fail "--git-sha cannot be repeated"
        operator_git_sha="${1#*=}"
        operator_git_sha_set=true
        shift
        ;;
      --control-url|--release-tag|--reports-root|--timeout-seconds|--poll-seconds|--request-timeout-seconds)
        (( $# >= 2 )) || fail "$1 requires a value"
        [[ "$2" != --* ]] || fail "$1 requires a value"
        registration_args+=("$1" "$2")
        shift 2
        ;;
      --control-url=*|--release-tag=*|--reports-root=*|--timeout-seconds=*|--poll-seconds=*|--request-timeout-seconds=*)
        registration_args+=("$1")
        shift
        ;;
      *)
        fail "operators preflight only supports the authoritative full/profile selection"
        ;;
    esac
  done

  [[ "$operator_git_sha_set" == "true" ]] || \
    fail "Git SHA is required and must be a full 40-character hexadecimal revision"
  normalize_git_sha "$operator_git_sha"
  expected_git_sha="$NORMALIZED_GIT_SHA"
  registration_args+=(--git-sha "$expected_git_sha")

  command -v docker >/dev/null 2>&1 || fail "docker command is unavailable"
  docker version >/dev/null 2>&1 || fail "Docker daemon is unavailable"
  docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is unavailable"
  operator_compose="${deploy_root}/docker-compose.operators.yml"
  course_root="${COURSE_ROOT:-/data/course}"
  result_root="${RESULT_ROOT:-/data/result}"
  if ! operator_compose_json="$(docker compose --project-directory "$deploy_root" \
    -f "$operator_compose" --profile '*' config --format json)"; then
    fail "operator Compose rendering failed"
  fi
  if ! selected_output="$("$preflight_python" "$preflight_checks" operator-selection \
    --course-root "$course_root" --result-root "$result_root" \
    "${selection_args[@]}" <(printf '%s' "$operator_compose_json"))"; then
    exit 1
  fi
  read -r -a selected_services <<<"$selected_output"
  (( ${#selected_services[@]} > 0 )) || fail "operator selection is empty"

  if ! running_output="$(docker compose --project-directory "$deploy_root" \
    -f "$operator_compose" --profile '*' ps --no-trunc --status running -q \
    "${selected_services[@]}")"; then
    fail "operator running container inspection failed"
  fi
  read -r -a running_containers <<<"$(printf '%s\n' "$running_output" | tr '\n' ' ')"
  (( ${#running_containers[@]} == ${#selected_services[@]} )) || fail \
    "selected services require exactly ${#selected_services[@]} running containers; found ${#running_containers[@]}"
  if ! inspection_json="$(docker inspect "${running_containers[@]}")"; then
    fail "docker inspect failed for selected operator containers"
  fi
  service_args=()
  for service_name in "${selected_services[@]}"; do
    service_args+=(--service "$service_name")
  done
  if ! image_id_output="$("$preflight_python" "$preflight_checks" container-images \
    "${service_args[@]}" <(printf '%s' "$inspection_json"))"; then
    exit 1
  fi
  read -r -a image_ids <<<"$image_id_output"
  (( ${#image_ids[@]} > 0 )) || fail "operator image selection is empty"
  if ! image_inspection_json="$(docker image inspect "${image_ids[@]}")"; then
    fail "docker image inspect failed for selected operator images"
  fi
  "$preflight_python" "$preflight_checks" operator-runtime \
    --course-root "$course_root" --result-root "$result_root" \
    --git-sha "$expected_git_sha" \
    --image-inspection-json <(printf '%s' "$image_inspection_json") \
    "${selection_args[@]}" \
    <(printf '%s' "$operator_compose_json") \
    <(printf '%s' "$inspection_json") || exit 1
  printf 'preflight: OK: selected operator image revisions\n'
  printf 'preflight: OK: selected running operator containers match Compose\n'

  package_probe_args=()
  for container_id in "${running_containers[@]}"; do
    package_probe_args+=(--container "$container_id")
  done
  "${deploy_root}/scripts/verify-operator-runtime-package" \
    --expected-version 0.2.0 "${package_probe_args[@]}" || exit 1
  printf 'preflight: OK: selected operator runtime wheel and migrated settings\n'

  "${deploy_root}/scripts/verify-operator-registration" \
    "${registration_args[@]}" "${selection_args[@]}" \
    --expected-compose "$operator_compose" || exit 1
  printf 'preflight: OK: operator registration and first heartbeat\n'
  printf 'preflight operators: NOTE: GPU inference activity is not checked here; run verify-gpu-instance with the operator smoke stage\n'
  printf 'preflight operators: PASS\n'
}

stage="${1:-host}"
if (( $# > 0 )); then
  shift
fi
case "$stage" in
  host)
    (( $# == 0 )) || fail "usage: preflight [host|runtime|operators]"
    run_host
    ;;
  runtime)
    run_runtime "$@"
    ;;
  operators)
    run_operators "$@"
    ;;
  *)
    fail "usage: preflight [host|runtime|operators]"
    ;;
esac
