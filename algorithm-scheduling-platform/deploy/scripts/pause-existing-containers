#!/usr/bin/env bash
set -euo pipefail

python3 - "$@" <<'PY'
import fcntl
import hashlib
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
from pathlib import Path


def fail(message: str) -> None:
    raise SystemExit(f"pause: {message}")


def canonical(value: dict) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()


def atomic_write(path: Path, records: list[dict]) -> None:
    if path.is_symlink():
        fail(f"refusing symlink ledger: {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            for record in records:
                stream.write(json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def open_operation_lock(path: Path) -> int:
    parent = path.parent
    if parent.is_symlink() or not parent.is_dir():
        fail(f"operation lock directory must be a real directory: {parent}")
    parent_mode = parent.stat().st_mode
    if parent_mode & (stat.S_IWGRP | stat.S_IWOTH):
        fail(f"operation lock directory must not be group/other writable: {parent}")
    flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_CLOEXEC", 0)
    flags |= getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(path, flags, 0o600)
    except OSError as error:
        fail(f"cannot securely open operation lock {path}: {error}")
    metadata = os.fstat(fd)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.geteuid():
        os.close(fd)
        fail(f"operation lock must be an owned regular file: {path}")
    os.fchmod(fd, 0o600)
    return fd


def read_snapshot(path: Path) -> list[dict]:
    if path.is_symlink() or not path.is_file():
        fail(f"snapshot must be a regular file: {path}")
    required = {
        "container_id", "name", "image_ref", "image_id", "state", "labels", "ports",
        "mounts", "restart_policy", "compose_project",
    }
    records = []
    for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        try:
            record = json.loads(line)
        except json.JSONDecodeError as error:
            fail(f"malformed snapshot line {number}: {error}")
        if not isinstance(record, dict) or not required.issubset(record):
            fail(f"incomplete snapshot line {number}")
        if not re.fullmatch(r"[0-9a-f]{12,64}", record["container_id"]):
            fail(f"invalid container ID on snapshot line {number}")
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", record["name"]):
            fail(f"invalid container name on snapshot line {number}")
        label_project = (record["labels"] or {}).get("com.docker.compose.project", "")
        if record["compose_project"] != label_project:
            fail(f"compose_project mismatch on snapshot line {number}")
        records.append(record)
    return records


def inspect(selector: str) -> dict:
    completed = subprocess.run(
        ["docker", "inspect", selector], text=True, capture_output=True, check=False
    )
    if completed.returncode:
        fail(f"container no longer exists: {selector}")
    values = json.loads(completed.stdout)
    if not isinstance(values, list) or len(values) != 1 or not isinstance(values[0], dict):
        fail("docker inspect returned an unexpected payload")
    return values[0]


def current_binding(item: dict) -> dict:
    labels = item.get("Config", {}).get("Labels") or {}
    return {
        "container_id": item.get("Id"),
        "name": item.get("Name", "").removeprefix("/"),
        "image_ref": item.get("Config", {}).get("Image"),
        "image_id": item.get("Image"),
        "state": item.get("State", {}).get("Status"),
        "labels": labels,
        "ports": item.get("HostConfig", {}).get("PortBindings") or {},
        "mounts": [
            {
                "type": mount.get("Type"), "source": mount.get("Source"),
                "destination": mount.get("Destination"), "mode": mount.get("Mode"),
                "rw": mount.get("RW"), "propagation": mount.get("Propagation"),
            }
            for mount in item.get("Mounts", [])
        ],
        "restart_policy": item.get("HostConfig", {}).get("RestartPolicy") or {},
        "compose_project": labels.get("com.docker.compose.project", ""),
    }


def verify(expected: dict) -> None:
    by_id = inspect(expected["container_id"])
    by_name = inspect(expected["name"])
    if by_name.get("Id") != expected["container_id"]:
        fail(f"{expected['name']}: name reuse detected")
    current = current_binding(by_id)
    for attribute in expected:
        if current.get(attribute) != expected[attribute]:
            fail(f"{expected['name']}: {attribute} changed")


if len(sys.argv) < 3:
    fail(f"usage: {sys.argv[0]} SNAPSHOT_JSONL CONTAINER_ID_OR_NAME [...]")
snapshot_path = Path(sys.argv[1])
ledger_path = Path(os.environ.get("PAUSE_RECORD_PATH", f"{snapshot_path}.paused.jsonl"))
records = read_snapshot(snapshot_path)
by_id = {record["container_id"]: record for record in records}
by_name = {record["name"]: record for record in records}
if len(by_id) != len(records) or len(by_name) != len(records):
    fail("duplicate container ID or name in snapshot")
selected = []
seen = set()
for selector in sys.argv[2:]:
    record = by_id.get(selector) or by_name.get(selector)
    if record is None:
        fail(f"selector is not present in snapshot: {selector}")
    if record["container_id"] in seen:
        fail(f"duplicate selector: {selector}")
    seen.add(record["container_id"])
    selected.append(record)

lock_path = Path(os.environ.get("DEPLOY_OPERATION_LOCK", ledger_path.parent / ".container-protection.lock"))
lock_path.parent.mkdir(parents=True, exist_ok=True)
lock_fd = open_operation_lock(lock_path)
try:
    fcntl.flock(lock_fd, fcntl.LOCK_EX)
    # This lock serializes this tool only; external Docker operations remain outside its control.
    if ledger_path.is_symlink() or ledger_path.exists():
        fail(f"refusing existing or symlink ledger: {ledger_path}")
    for record in selected:
        if record["state"] == "running":
            verify(record)
    ledger = []
    atomic_write(ledger_path, ledger)
    for record in selected:
        if record["state"] != "running":
            print(f"pause: {record['name']} ({record['container_id']}): unchanged (snapshot state {record['state']})")
            continue
        verify(record)
        entry = {
            "version": 1,
            "status": "pending_stop",
            "container_id": record["container_id"],
            "name": record["name"],
            "snapshot_sha256": hashlib.sha256(canonical(record)).hexdigest(),
            "binding": record,
        }
        ledger.append(entry)
        atomic_write(ledger_path, ledger)
        completed = subprocess.run(["docker", "stop", record["container_id"]], check=False)
        if completed.returncode:
            fail(f"{record['name']}: docker stop failed; pending_stop intent preserved")
        entry["status"] = "stopped"
        atomic_write(ledger_path, ledger)
        print(f"pause: {record['name']} ({record['container_id']}): stopped")
finally:
    os.close(lock_fd)
print(f"pause: complete: {ledger_path}")
PY
