#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from collections.abc import Sequence

EXPECTED_DISTRIBUTION = "algorithm-operator-registry-client"
EXPECTED_VERSION = "0.2.0"
COMMAND_TIMEOUT_SECONDS = 30
CONTAINER_PATTERN = re.compile(r"[a-z0-9][a-z0-9_.-]{0,127}")
FORBIDDEN_READ_NAMES = (
    "PLATFORM_REGISTRATION_ENABLED",
    "PLATFORM_CONTROL_SERVICE_URL",
    "PLATFORM_HEARTBEAT_INTERVAL_SECONDS",
    "PLATFORM_DECLARED_CAPACITY",
    "REQUIRE_GPU",
)
PROBE_SOURCE = r'''
import importlib.metadata
import json
from pathlib import Path

distribution = importlib.metadata.distribution("algorithm-operator-registry-client")
sources = []
for item in distribution.files or ():
    path = Path(distribution.locate_file(item))
    if path.suffix == ".py" and path.is_file():
        sources.append(path)
app_root = Path.cwd() / "app"
if app_root.is_dir():
    sources.extend(path for path in app_root.rglob("*.py") if path.is_file())
forbidden_names = (
    "PLATFORM_REGISTRATION_ENABLED",
    "PLATFORM_CONTROL_SERVICE_URL",
    "PLATFORM_HEARTBEAT_INTERVAL_SECONDS",
    "PLATFORM_DECLARED_CAPACITY",
    "REQUIRE_GPU",
)
forbidden_reads = sorted({
    name
    for path in sources
    for name in forbidden_names
    if name in path.read_text(encoding="utf-8", errors="strict")
})
print(json.dumps({
    "distribution": "algorithm-operator-registry-client",
    "version": distribution.version,
    "forbidden_reads": forbidden_reads,
}, sort_keys=True, separators=(",", ":")))
'''.strip()


class VerificationError(RuntimeError):
    pass


def _parse_args(argv: Sequence[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="验证运行中算子镜像的公共注册 wheel 与迁移配置读取"
    )
    parser.add_argument("--container", action="append", required=True)
    parser.add_argument("--expected-version", default=EXPECTED_VERSION)
    return parser.parse_args(argv)


def _verify_container(container: str, expected_version: str) -> None:
    completed: subprocess.CompletedProcess[str] | None = None
    for interpreter in ("python", "python3"):
        try:
            attempt = subprocess.run(
                ["docker", "exec", container, interpreter, "-c", PROBE_SOURCE],
                text=True,
                capture_output=True,
                check=False,
                timeout=COMMAND_TIMEOUT_SECONDS,
            )
        except subprocess.TimeoutExpired as error:
            raise VerificationError(
                f"{container}: runtime package probe timed out"
            ) from error
        completed = attempt
        if attempt.returncode == 0:
            break
    assert completed is not None
    if completed.returncode != 0:
        raise VerificationError(f"{container}: runtime package probe failed")
    lines = completed.stdout.splitlines()
    if len(lines) != 1:
        raise VerificationError(f"{container}: runtime package probe must emit one JSON line")
    try:
        payload = json.loads(lines[0])
    except json.JSONDecodeError as error:
        raise VerificationError(
            f"{container}: runtime package probe returned invalid JSON"
        ) from error
    expected = {
        "distribution": EXPECTED_DISTRIBUTION,
        "version": expected_version,
        "forbidden_reads": [],
    }
    if payload != expected:
        raise VerificationError(
            f"{container}: runtime package contract mismatch: {payload!r}"
        )


def main(argv: Sequence[str] | None = None) -> int:
    arguments = _parse_args(argv)
    containers = arguments.container
    if len(containers) != len(set(containers)):
        print("runtime package verification failed: duplicate container", file=sys.stderr)
        return 2
    if re.fullmatch(r"[0-9]+(?:\.[0-9]+){2}", arguments.expected_version) is None:
        print("runtime package verification failed: invalid expected version", file=sys.stderr)
        return 2
    try:
        for container in containers:
            if CONTAINER_PATTERN.fullmatch(container) is None:
                raise VerificationError(f"unsafe container identifier: {container}")
            _verify_container(container, arguments.expected_version)
    except VerificationError as error:
        print(f"runtime package verification failed: {error}", file=sys.stderr)
        return 2
    print(
        f"runtime package verification passed: {len(containers)} operator containers"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
