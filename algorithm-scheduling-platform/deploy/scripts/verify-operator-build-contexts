#!/usr/bin/env python3
from __future__ import annotations

import json
import re
import shlex
import subprocess
import sys
from pathlib import Path, PurePosixPath

from deployment_contracts import validate_registry_wheel_dockerfile
from operator_topology import CURRENT_TOPOLOGY

EXPECTED_MATRIX = tuple(
    (entry.project_directory, entry.dockerfile, entry.image_repository)
    for entry in CURRENT_TOPOLOGY.operators
)

REQUIRED_IGNORE_GROUPS = (
    (".git", ".git", ".git/"),
    ("tests", "tests", "tests/", "test", "test/", "**/tests/", "**/test/"),
    ("Python cache", "__pycache__", "__pycache__/", "**/__pycache__/", "*.py[cod]"),
    ("pytest cache", ".pytest_cache/", ".pytest_cache", "**/.pytest_cache/"),
    ("mypy cache", ".mypy_cache/", ".mypy_cache", "**/.mypy_cache/"),
    ("ruff cache", ".ruff_cache/", ".ruff_cache", "**/.ruff_cache/"),
    ("Codex state", ".codex/", ".codex", "**/.codex/"),
    ("Harness data", "harness/", "harness", "**/harness/"),
    ("OpenSpec state", "openspec/", "openspec", "**/openspec/"),
    ("environment secrets", ".env", ".env.*", "*.env", "**/.env"),
    ("PEM secrets", "*.pem", "**/*.pem"),
    ("private keys", "*.key", "**/*.key"),
    ("PKCS12 secrets", "*.p12", "**/*.p12", "*.pfx", "**/*.pfx"),
    ("foreign wheels", "wheel/*.whl"),
)

REGISTRY_WHEEL_REINCLUDE = (
    "!wheel/algorithm_operator_registry_client-0.2.0-py3-none-any.whl"
)

ALLOWED_REINCLUDES = {
    "asr_offline": {"!model/**/*.wav", REGISTRY_WHEEL_REINCLUDE},
    "asr_online": {REGISTRY_WHEEL_REINCLUDE},
    "ocr": {REGISTRY_WHEEL_REINCLUDE, "!config.toml.example"},
    "vbas": {
        REGISTRY_WHEEL_REINCLUDE,
        "!models/",
        "!models/**",
        "!app/vendor/DirectMHP/models/",
        "!app/vendor/DirectMHP/models/**",
    },
    "facerec": {REGISTRY_WHEEL_REINCLUDE},
    "screen_det": {REGISTRY_WHEEL_REINCLUDE},
    "ppt_slice": {REGISTRY_WHEEL_REINCLUDE},
}

MODEL_ASSET_ROOTS = {
    "asr_offline": ("model",),
    "asr_online": ("model",),
    "ocr": ("models",),
    "vbas": ("models",),
    "facerec": ("ai_models",),
    "screen_det": ("model",),
}

DANGEROUS_MEDIA_SUFFIXES = frozenset(
    {
        ".mp4",
        ".mov",
        ".mkv",
        ".avi",
        ".wav",
        ".mp3",
        ".pcm",
        ".flac",
        ".jpg",
        ".jpeg",
        ".png",
        ".bmp",
    }
)

PROTECTED_PARTS = frozenset(
    {
        ".git",
        ".codex",
        "harness",
        "openspec",
        "test",
        "tests",
        "__pycache__",
        ".pytest_cache",
        ".mypy_cache",
        ".ruff_cache",
    }
)

SECRET_SUFFIXES = frozenset({".pem", ".key", ".p12", ".pfx"})

IGNORABLE_UNTRACKED_NAMES = frozenset({".DS_Store", ".gitkeep"})


class GateError(RuntimeError):
    pass


def _logical_lines(source: str) -> list[str]:
    lines: list[str] = []
    pending = ""
    escape = "\\"
    for raw_line in source.splitlines():
        stripped = raw_line.strip()
        if not pending and stripped.lower().startswith("# escape="):
            value = stripped.partition("=")[2].strip()
            if value not in {"\\", "`"}:
                raise GateError(f"unsupported Dockerfile escape directive: {stripped}")
            escape = value
            continue
        if not stripped or stripped.startswith("#"):
            continue
        pending = f"{pending} {stripped}".strip()
        if pending.endswith(escape):
            pending = pending[:-1].rstrip()
            continue
        lines.append(pending)
        pending = ""
    if pending:
        lines.append(pending)
    return lines


def _copy_sources(instruction: str) -> tuple[str | None, bool, list[str]]:
    match = re.match(r"^([A-Za-z]+)\s+(.+)$", instruction, flags=re.DOTALL)
    if match is None:
        raise GateError(f"cannot parse Dockerfile instruction: {instruction}")
    operation, arguments = match.groups()
    if operation.upper() not in {"COPY", "ADD"}:
        return None, False, []
    if not arguments:
        raise GateError(f"invalid {operation} instruction: {instruction}")
    from_stage = False
    remainder = arguments.lstrip()
    while remainder.startswith("--"):
        flag_match = re.match(r"^(--[a-z-]+)(?:=([^\s]+)|\s+([^\s]+))\s+", remainder)
        if flag_match is None:
            raise GateError(f"cannot parse {operation} flag: {instruction}")
        option_name, equals_value, separate_value = flag_match.groups()
        if option_name not in {"--chown", "--chmod", "--exclude", "--checksum", "--from"}:
            raise GateError(f"unsupported {operation} flag: {option_name}")
        if option_name == "--from":
            from_stage = True
        if equals_value is None and separate_value is None:
            raise GateError(f"missing value for {option_name}")
        remainder = remainder[flag_match.end() :].lstrip()
    if remainder.startswith("["):
        parsed_values = json.loads(remainder)
        if not isinstance(parsed_values, list) or len(parsed_values) < 2 or not all(
            isinstance(value, str) for value in parsed_values
        ):
            raise GateError(f"invalid JSON {operation} instruction: {instruction}")
        return operation.upper(), from_stage, parsed_values[:-1]
    values = shlex.split(remainder)
    if len(values) < 2:
        raise GateError(f"invalid {operation} instruction: {instruction}")
    return operation.upper(), from_stage, values[:-1]


def _validate_source(context: str, dockerfile: str, source: str) -> None:
    normalized = source.replace("\\", "/")
    path = PurePosixPath(normalized)
    is_remote = bool(
        re.match(r"^[a-zA-Z][a-zA-Z0-9+.-]*://", normalized)
        or re.match(r"^[^/@\s]+@[^/:\s]+:.+", normalized)
    )
    if is_remote:
        raise GateError(
            f"Dockerfile remote COPY/ADD source is forbidden: "
            f"{context}/{dockerfile}: {source}"
        )
    if (
        path.is_absolute()
        or any(part == ".." for part in path.parts)
        or normalized.startswith("$")
    ):
        raise GateError(
            f"Dockerfile COPY/ADD source is outside build context: "
            f"{context}/{dockerfile}: {source}"
        )


def _glob_regex(pattern: str) -> re.Pattern[str]:
    result = ""
    index = 0
    while index < len(pattern):
        character = pattern[index]
        if character == "*":
            if index + 1 < len(pattern) and pattern[index + 1] == "*":
                index += 1
                if index + 1 < len(pattern) and pattern[index + 1] == "/":
                    index += 1
                    result += "(?:.*/)?"
                else:
                    result += ".*"
            else:
                result += "[^/]*"
        elif character == "?":
            result += "[^/]"
        elif character == "[":
            closing = pattern.find("]", index + 1)
            if closing == -1:
                result += r"\["
            else:
                result += pattern[index : closing + 1]
                index = closing
        else:
            result += re.escape(character)
        index += 1
    return re.compile(f"^{result}$")


def _pattern_matches(pattern: str, relative_path: str) -> bool:
    normalized = pattern.replace("\\", "/").lstrip("/")
    directory_pattern = normalized.endswith("/")
    normalized = normalized.rstrip("/")
    if not normalized:
        return False
    path = PurePosixPath(relative_path)
    if "/" not in normalized:
        matcher = _glob_regex(normalized)
        parts = path.parts[:-1] if directory_pattern else path.parts
        return any(matcher.fullmatch(part) for part in parts)
    matcher = _glob_regex(normalized)
    candidates = [relative_path]
    if directory_pattern:
        candidates.extend("/".join(path.parts[:index]) for index in range(1, len(path.parts)))
    return any(matcher.fullmatch(candidate) for candidate in candidates)


def _is_ignored(relative_path: str, patterns: list[str]) -> bool:
    ignored = False
    for raw_pattern in patterns:
        negated = raw_pattern.startswith("!")
        pattern = raw_pattern[1:] if negated else raw_pattern
        if _pattern_matches(pattern, relative_path):
            ignored = not negated
    return ignored


def _under_allowed_root(relative_path: str, roots: tuple[str, ...]) -> bool:
    return any(
        relative_path == root or relative_path.startswith(f"{root}/") for root in roots
    )


def _pollution_reason(
    context_name: str, relative_path: str
) -> str | None:
    path = PurePosixPath(relative_path)
    lowered_parts = tuple(part.lower() for part in path.parts)
    lowered_name = path.name.lower()
    suffix = path.suffix.lower()
    if any(part in PROTECTED_PARTS for part in lowered_parts):
        return "protected test/cache/tooling path"
    if lowered_name == ".env" or lowered_name.startswith(".env."):
        return "environment secret"
    if suffix in SECRET_SUFFIXES:
        return "secret-file suffix"
    if suffix in DANGEROUS_MEDIA_SUFFIXES and not _under_allowed_root(
        relative_path, MODEL_ASSET_ROOTS.get(context_name, ())
    ):
        return "test/media artifact outside an approved model root"
    return None


def _dockerignore_patterns(source: str) -> list[str]:
    return [
        line.strip()
        for line in source.splitlines()
        if line.strip() and not line.lstrip().startswith("#")
    ]


def _validate_context_files(
    context_name: str, context: Path, patterns: list[str]
) -> None:
    for path in context.rglob("*"):
        if not path.is_file() and not path.is_symlink():
            continue
        relative_path = path.relative_to(context).as_posix()
        reason = _pollution_reason(context_name, relative_path)
        if reason is not None and not _is_ignored(relative_path, patterns):
            raise GateError(
                f"{context_name} build context includes forbidden {reason}: {relative_path}"
            )


def _git_paths(workspace_root: Path, *arguments: str) -> set[str]:
    completed = subprocess.run(
        ["git", "-C", str(workspace_root), *arguments],
        check=True,
        capture_output=True,
        timeout=30,
    )
    return {
        item.decode("utf-8")
        for item in completed.stdout.split(b"\0")
        if item
    }


def _included_operator_paths(
    workspace_root: Path,
    matrix: tuple[tuple[str, str, str], ...],
) -> set[str]:
    included: set[str] = set()
    for context_name, _, _ in matrix:
        context = workspace_root / context_name
        patterns = _dockerignore_patterns(
            (context / ".dockerignore").read_text(encoding="utf-8")
        )
        for path in context.rglob("*"):
            if not path.is_file() and not path.is_symlink():
                continue
            relative_to_context = path.relative_to(context).as_posix()
            if not _is_ignored(relative_to_context, patterns):
                included.add(path.relative_to(workspace_root).as_posix())
    included.update(
        f"{context_name}/{dockerfile_name}"
        for context_name, dockerfile_name, _ in matrix
    )
    return included


def _deleted_included_operator_paths(
    workspace_root: Path,
    matrix: tuple[tuple[str, str, str], ...],
    dirty: set[str],
) -> set[str]:
    deleted = {
        path
        for path in dirty
        if not (workspace_root / path).exists()
    }
    included: set[str] = set()
    for context_name, dockerfile_name, _ in matrix:
        context_prefix = f"{context_name}/"
        patterns = _dockerignore_patterns(
            (workspace_root / context_name / ".dockerignore").read_text(encoding="utf-8")
        )
        for path in deleted:
            if not path.startswith(context_prefix):
                continue
            relative_to_context = path.removeprefix(context_prefix)
            if relative_to_context == dockerfile_name or not _is_ignored(
                relative_to_context, patterns
            ):
                included.add(path)
    return included


def _validate_git_inputs(
    workspace_root: Path,
    matrix: tuple[tuple[str, str, str], ...],
) -> None:
    dirty = _git_paths(workspace_root, "diff", "--name-only", "-z", "HEAD", "--")
    untracked = _git_paths(
        workspace_root,
        "ls-files",
        "--others",
        "-z",
        "--",
    )
    included = _included_operator_paths(workspace_root, matrix)
    deleted_included = _deleted_included_operator_paths(workspace_root, matrix, dirty)
    wheel_source_root = "algorithm-scheduling-platform/packages/operator_registry_client/"
    wheel_source_names = {
        "README.md",
        "pyproject.toml",
        "__init__.py",
        "client.py",
        "lifecycle.py",
        "ops.py",
        "runtime.py",
    }
    wheel_inputs = {
        path
        for path in dirty | untracked
        if (
            path.startswith(wheel_source_root)
            and path.removeprefix(wheel_source_root) in wheel_source_names
        )
        or path
        == "algorithm-scheduling-platform/scripts/build_and_stage_operator_registry_wheel.py"
    }
    untracked_included = {
        path
        for path in untracked.intersection(included)
        if not _under_allowed_root(
            path.partition("/")[2],
            MODEL_ASSET_ROOTS.get(path.partition("/")[0], ()),
        )
        and not path.endswith(
            "/wheel/algorithm_operator_registry_client-0.2.0-py3-none-any.whl"
        )
        and PurePosixPath(path).name not in IGNORABLE_UNTRACKED_NAMES
        and ".vscode" not in PurePosixPath(path).parts
    }
    unsafe = sorted(
        dirty.intersection(included)
        .union(deleted_included, untracked_included, wheel_inputs)
    )
    if unsafe:
        raise GateError(
            "Git revision does not describe included build inputs: " + ", ".join(unsafe)
        )


def _read_matrix(path: Path) -> tuple[tuple[str, str, str], ...]:
    rows: list[tuple[str, str, str]] = []
    for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
        if not line or line.startswith("#"):
            continue
        values = line.split("\t")
        if len(values) != 3:
            raise GateError(f"invalid image matrix line {number}")
        rows.append((values[0], values[1], values[2]))
    return tuple(rows)


def main() -> int:
    arguments = sys.argv[1:]
    allowed_arguments = {"--verify-git-clean-included", "--verify-registry-wheel"}
    if len(arguments) != len(set(arguments)) or any(
        argument not in allowed_arguments for argument in arguments
    ):
        raise GateError(
            "usage: verify-operator-build-contexts "
            "[--verify-git-clean-included] [--verify-registry-wheel]"
        )
    platform_root = Path(__file__).resolve().parents[2]
    workspace_root = platform_root.parent
    manifest = platform_root / "deploy/operator-images.tsv"
    matrix = _read_matrix(manifest)
    if matrix != EXPECTED_MATRIX:
        raise GateError(
            "operator image matrix differs from the frozen eight-image contract: "
            f"actual={matrix!r}"
        )
    for context_name, dockerfile_name, _ in matrix:
        if context_name in {".", "..", ""}:
            raise GateError("workspace root cannot be an operator build context")
        context = (workspace_root / context_name).resolve()
        if context.parent != workspace_root.resolve():
            raise GateError(f"operator context is outside workspace root: {context_name}")
        dockerfile = context / dockerfile_name
        dockerignore = context / ".dockerignore"
        if not context.is_dir() or not dockerfile.is_file():
            raise GateError(
                f"missing build context or Dockerfile: {context_name}/{dockerfile_name}"
            )
        if not dockerignore.is_file():
            raise GateError(f"missing .dockerignore: {context_name}")
        dockerignore_source = dockerignore.read_text(encoding="utf-8")
        patterns = _dockerignore_patterns(dockerignore_source)
        ignore_lines = {line for line in patterns if not line.startswith("!")}
        missing_groups = [
            name
            for name, *patterns in REQUIRED_IGNORE_GROUPS
            if not ignore_lines.intersection(patterns)
        ]
        if missing_groups:
            raise GateError(
                f"{context_name}/.dockerignore does not block required context pollution: "
                f"{', '.join(missing_groups)}"
            )
        allowed_reincludes = ALLOWED_REINCLUDES.get(context_name, set())
        forbidden_reincludes = [
            pattern
            for pattern in patterns
            if pattern.startswith("!") and pattern not in allowed_reincludes
        ]
        if forbidden_reincludes:
            raise GateError(
                f"{context_name}/.dockerignore must not re-include protected inputs: "
                f"{', '.join(forbidden_reincludes)}"
            )
        _validate_context_files(context_name, context, patterns)
        dockerfile_source = dockerfile.read_text(encoding="utf-8")
        if "--verify-registry-wheel" in arguments:
            try:
                validate_registry_wheel_dockerfile(
                    dockerfile_source, f"{context_name}/{dockerfile_name}"
                )
            except ValueError as error:
                raise GateError(str(error)) from error
        for instruction in _logical_lines(dockerfile_source):
            _, from_stage, sources = _copy_sources(instruction)
            if from_stage:
                continue
            for source in sources:
                _validate_source(context_name, dockerfile_name, source)
        print(f"build-context: OK: {context_name}/{dockerfile_name}")
    if "--verify-git-clean-included" in arguments:
        _validate_git_inputs(workspace_root, matrix)
        print("build-context: OK: Git describes included build inputs")
    print("build-context: PASS")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (GateError, OSError, ValueError, json.JSONDecodeError) as error:
        print(f"build-context: FAIL: {error}", file=sys.stderr)
        raise SystemExit(1) from error
