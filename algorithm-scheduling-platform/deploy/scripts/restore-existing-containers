#!/usr/bin/env bash
set -euo pipefail

python3 - "$@" <<'PY'
import fcntl
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path


def fail(message: str) -> None:
    raise SystemExit(f"restore: {message}")


def canonical(value: dict) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()


def atomic_write(path: Path, records: list[dict]) -> None:
    if path.is_symlink():
        fail(f"refusing symlink ledger: {path}")
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            for record in records:
                stream.write(json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def read_jsonl(path: Path, kind: str) -> list[dict]:
    if path.is_symlink() or not path.is_file():
        fail(f"{kind} must be a regular file: {path}")
    records = []
    for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        try:
            record = json.loads(line)
        except json.JSONDecodeError as error:
            fail(f"malformed {kind} line {number}: {error}")
        if not isinstance(record, dict):
            fail(f"invalid {kind} line {number}")
        records.append(record)
    return records


def inspect(selector: str) -> dict:
    completed = subprocess.run(
        ["docker", "inspect", selector], text=True, capture_output=True, check=False
    )
    if completed.returncode:
        fail(f"container no longer exists: {selector}")
    values = json.loads(completed.stdout)
    if not isinstance(values, list) or len(values) != 1 or not isinstance(values[0], dict):
        fail("docker inspect returned an unexpected payload")
    return values[0]


def current_binding(item: dict, snapshot_state: str) -> dict:
    labels = item.get("Config", {}).get("Labels") or {}
    return {
        "container_id": item.get("Id"),
        "name": item.get("Name", "").removeprefix("/"),
        "image_ref": item.get("Config", {}).get("Image"),
        "image_id": item.get("Image"),
        "state": snapshot_state,
        "labels": labels,
        "ports": item.get("HostConfig", {}).get("PortBindings") or {},
        "mounts": [
            {
                "type": mount.get("Type"), "source": mount.get("Source"),
                "destination": mount.get("Destination"), "mode": mount.get("Mode"),
                "rw": mount.get("RW"), "propagation": mount.get("Propagation"),
            }
            for mount in item.get("Mounts", [])
        ],
        "restart_policy": item.get("HostConfig", {}).get("RestartPolicy") or {},
        "compose_project": labels.get("com.docker.compose.project", ""),
    }


def verify(entry: dict) -> str:
    expected = entry["binding"]
    by_id = inspect(entry["container_id"])
    by_name = inspect(entry["name"])
    if by_name.get("Id") != entry["container_id"]:
        fail(f"{entry['name']}: name reuse detected")
    current = current_binding(by_id, expected["state"])
    for attribute in expected:
        if current.get(attribute) != expected[attribute]:
            fail(f"{entry['name']}: {attribute} changed")
    return by_id.get("State", {}).get("Status", "")


if len(sys.argv) != 3:
    fail(f"usage: {sys.argv[0]} SNAPSHOT_JSONL PAUSE_RECORD_JSONL")
snapshot_path = Path(sys.argv[1])
ledger_path = Path(sys.argv[2])
snapshots = read_jsonl(snapshot_path, "snapshot")
ledger = read_jsonl(ledger_path, "pause ledger")
snapshot_required = {
    "container_id", "name", "image_ref", "image_id", "state", "labels", "ports",
    "mounts", "restart_policy", "compose_project",
}
for number, record in enumerate(snapshots, 1):
    if not snapshot_required.issubset(record):
        fail(f"incomplete snapshot line {number}")
    if not re.fullmatch(r"[0-9a-f]{12,64}", record["container_id"]):
        fail(f"invalid container ID on snapshot line {number}")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", record["name"]):
        fail(f"invalid container name on snapshot line {number}")
    labels = record.get("labels") or {}
    if record.get("compose_project") != labels.get("com.docker.compose.project", ""):
        fail(f"compose_project mismatch on snapshot line {number}")
snapshot_by_id = {record.get("container_id"): record for record in snapshots}
required = {"version", "status", "container_id", "name", "snapshot_sha256", "binding"}
allowed = {"pending_stop", "stopped", "restoring", "restored", "not_stopped"}
for number, entry in enumerate(ledger, 1):
    if not required.issubset(entry) or entry["version"] != 1 or entry["status"] not in allowed:
        fail(f"incomplete pause ledger line {number}")
    if not re.fullmatch(r"[0-9a-f]{12,64}", entry["container_id"]):
        fail(f"invalid container ID on pause ledger line {number}")
    binding = entry["binding"]
    if binding != snapshot_by_id.get(entry["container_id"]):
        fail(f"ledger binding differs from snapshot on line {number}")
    if entry["name"] != binding.get("name"):
        fail(f"ledger name differs from binding on line {number}")
    if entry["snapshot_sha256"] != hashlib.sha256(canonical(binding)).hexdigest():
        fail(f"snapshot hash mismatch on pause ledger line {number}")
    if binding.get("state") != "running":
        fail(f"refusing originally non-running container on line {number}")
    labels = binding.get("labels") or {}
    if binding.get("compose_project") != labels.get("com.docker.compose.project", ""):
        fail(f"compose_project mismatch on pause ledger line {number}")

lock_path = Path(os.environ.get("DEPLOY_OPERATION_LOCK", ledger_path.parent / ".container-protection.lock"))
if lock_path.is_symlink():
    fail(f"refusing symlink operation lock: {lock_path}")
with lock_path.open("a+", encoding="utf-8") as lock:
    os.chmod(lock_path, 0o600)
    fcntl.flock(lock, fcntl.LOCK_EX)
    # There is an unavoidable external-concurrency window around Docker actions.
    for entry in ledger:
        status = entry["status"]
        state = verify(entry)
        if status == "not_stopped":
            if state != "running":
                fail(f"{entry['name']}: not_stopped container state changed")
            print(f"restore: {entry['name']}: not_stopped; no start required")
            continue
        if status == "restored":
            if state != "running":
                fail(f"{entry['name']}: restored container is not running")
            print(f"restore: {entry['name']}: already restored")
            continue
        if status == "pending_stop" and state == "running":
            entry["status"] = "not_stopped"
            atomic_write(ledger_path, ledger)
            print(f"restore: {entry['name']}: not_stopped; pending stop did not execute")
            continue
        if status == "restoring" and state == "running":
            entry["status"] = "restored"
            atomic_write(ledger_path, ledger)
            print(f"restore: {entry['name']}: already restored after interrupted update")
            continue
        if state != "exited":
            fail(f"{entry['name']}: state {state} is not safe to restore")
        recovered_pending = status == "pending_stop"
        entry["status"] = "restoring"
        atomic_write(ledger_path, ledger)
        completed = subprocess.run(["docker", "start", entry["container_id"]], check=False)
        if completed.returncode:
            fail(f"{entry['name']}: docker start failed; restoring state preserved")
        entry["status"] = "restored"
        atomic_write(ledger_path, ledger)
        suffix = " recovered_from_pending" if recovered_pending else ""
        print(f"restore: {entry['name']} ({entry['container_id']}): started{suffix}")
print("restore: complete")
PY
