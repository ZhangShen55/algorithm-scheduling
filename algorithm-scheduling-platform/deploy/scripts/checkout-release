#!/usr/bin/env python3
"""Atomically checkout one fixed release commit using a private Deploy Key."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

from deployment_contracts import DeploymentContractError, checkout_release


def main() -> int:
    parser = argparse.ArgumentParser(prog="checkout-release")
    parser.add_argument("--repository", required=True)
    parser.add_argument("--git-sha", required=True)
    parser.add_argument("--destination", required=True, type=Path)
    parser.add_argument("--identity-file", required=True, type=Path)
    arguments = parser.parse_args()
    checkout_release(
        repository=arguments.repository,
        git_sha=arguments.git_sha,
        destination=arguments.destination,
        identity_file=arguments.identity_file,
    )
    print(f"checkout-release: PASS: {arguments.git_sha}")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except DeploymentContractError as error:
        print(f"checkout-release: FAIL: {error}", file=sys.stderr)
        raise SystemExit(1) from error
