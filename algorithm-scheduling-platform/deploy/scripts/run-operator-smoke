#!/usr/bin/env bash
set -euo pipefail

platform_root="$(cd "$(dirname "$0")/../.." && pwd)"
project_python="${platform_root}/.venv/bin/python"
if [[ -n "${DEPLOY_PYTHON:-}" ]]; then
  [[ -f "$DEPLOY_PYTHON" && -x "$DEPLOY_PYTHON" ]] || {
    printf 'run-operator-smoke: DEPLOY_PYTHON is not an executable file: %s\n' "$DEPLOY_PYTHON" >&2
    exit 127
  }
  python="$DEPLOY_PYTHON"
elif [[ -f "$project_python" && -x "$project_python" ]]; then
  python="$project_python"
elif python="$(command -v python3 2>/dev/null)" && [[ -f "$python" && -x "$python" ]]; then
  :
else
  printf 'run-operator-smoke: no usable Python interpreter found\n' >&2
  exit 127
fi

exec "$python" \
  "${platform_root}/deploy/scripts/run_operator_smoke.py" "$@"
