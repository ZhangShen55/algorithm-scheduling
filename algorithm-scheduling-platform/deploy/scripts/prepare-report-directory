#!/usr/bin/env python3
from __future__ import annotations

import argparse
import fcntl
import os
import re
import signal
import stat
import sys
import uuid
from pathlib import Path

EVIDENCE_CATEGORIES = (
    "preflight",
    "container-maintenance",
    "image-build",
    "gpu-instances",
    "registration",
    "smoke",
    "negative",
    "load",
    "recovery",
    "summary",
)
RELEASE_TAG_PATTERN = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}")
GIT_SHA_PATTERN = re.compile(r"[0-9a-fA-F]{40}")
MANIFEST_NAME = "model-assets.manifest.json"
ARCHIVE_LOCK_NAME = ".model-manifest-archive.lock"
ARCHIVE_TEMP_PATTERN = re.compile(
    rf"\.{re.escape(MANIFEST_NAME)}\.archive-[0-9a-f]{{32}}\.tmp"
)


def _parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="初始化里程碑 2B 私有报告归档目录")
    parser.add_argument("--release-tag", required=True)
    parser.add_argument("--git-sha", required=True)
    parser.add_argument("--reports-root", type=Path, required=True)
    parser.add_argument("--restricted-root", type=Path, required=True)
    parser.add_argument("--external-manifest", type=Path)
    return parser.parse_args()


def _validate_component(value: str, pattern: re.Pattern[str], name: str) -> str:
    if value in {".", ".."} or pattern.fullmatch(value) is None:
        raise ValueError(f"{name} 不是安全的单路径段")
    return value


def _reject_traversal(path: Path, name: str) -> None:
    if ".." in path.parts:
        raise ValueError(f"{name} 不能包含父目录穿越")


def _reject_symlink_components(path: Path, name: str) -> None:
    absolute = path.absolute()
    for component in reversed(absolute.parents):
        if component == Path(component.anchor):
            continue
        try:
            metadata = os.lstat(component)
        except FileNotFoundError:
            continue
        if stat.S_ISLNK(metadata.st_mode):
            raise ValueError(f"{name} 的父路径不能包含软链接: {component}")


def _require_private_root(path: Path, name: str) -> Path:
    _reject_traversal(path, name)
    _reject_symlink_components(path, name)
    absolute = path.absolute()
    try:
        metadata = os.lstat(absolute)
    except FileNotFoundError:
        try:
            absolute.mkdir(mode=0o700, parents=False)
        except FileExistsError:
            pass
        metadata = os.lstat(absolute)
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
        raise ValueError(f"{name} 必须是直接目录且不能是软链接")
    os.chmod(absolute, 0o700)
    return absolute


def _ensure_private_tree(root: Path, *components: str) -> Path:
    current = root
    for component in components:
        current = current / component
        try:
            metadata = os.lstat(current)
        except FileNotFoundError:
            try:
                current.mkdir(mode=0o700)
            except FileExistsError:
                pass
            metadata = os.lstat(current)
        if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
            raise ValueError(f"归档路径组件不安全: {current}")
        os.chmod(current, 0o700)
    return current


def _paths_overlap(first: Path, second: Path) -> bool:
    first_resolved = first.resolve(strict=False)
    second_resolved = second.resolve(strict=False)
    common = Path(os.path.commonpath((first_resolved, second_resolved)))
    return common in {first_resolved, second_resolved}


def _inside_any_git_worktree(path: Path) -> bool:
    current = path.absolute()
    while True:
        if (current / ".git").exists():
            return True
        if current.parent == current:
            return False
        current = current.parent


def _read_private_manifest(source: Path) -> bytes:
    _reject_traversal(source, "外部模型 manifest")
    _reject_symlink_components(source, "外部模型 manifest")
    absolute = source.absolute()
    if _inside_any_git_worktree(absolute):
        raise ValueError("外部模型 manifest 必须位于所有 Git 工作树外")
    parent_fd = os.open(
        absolute.parent,
        os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | os.O_NOFOLLOW,
    )
    try:
        parent_metadata = os.fstat(parent_fd)
        if (
            not stat.S_ISDIR(parent_metadata.st_mode)
            or parent_metadata.st_uid != os.geteuid()
            or stat.S_IMODE(parent_metadata.st_mode) != 0o700
        ):
            raise ValueError("外部模型 manifest 直接父目录必须由当前用户拥有且权限为 0700")
        source_fd = os.open(
            absolute.name,
            os.O_RDONLY | os.O_NOFOLLOW,
            dir_fd=parent_fd,
        )
        try:
            metadata = os.fstat(source_fd)
            if (
                not stat.S_ISREG(metadata.st_mode)
                or metadata.st_uid != os.geteuid()
                or stat.S_IMODE(metadata.st_mode) != 0o600
            ):
                raise ValueError(
                    "外部模型 manifest 必须是当前用户拥有且权限为 0600 的普通文件"
                )
            source_bytes = bytearray()
            while chunk := os.read(source_fd, 1024 * 1024):
                source_bytes.extend(chunk)
        finally:
            os.close(source_fd)
    finally:
        os.close(parent_fd)
    return bytes(source_bytes)


def _fsync_directory(path: Path) -> None:
    directory_fd = os.open(
        path, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | os.O_NOFOLLOW
    )
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def _open_archive_lock(release_root: Path) -> int:
    descriptor = os.open(
        release_root / ARCHIVE_LOCK_NAME,
        os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW,
        0o600,
    )
    metadata = os.fstat(descriptor)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.geteuid():
        os.close(descriptor)
        raise ValueError("模型 manifest 归档锁必须是当前用户拥有的普通文件")
    os.fchmod(descriptor, 0o600)
    return descriptor


def _cleanup_archive_temporaries(release_root: Path) -> None:
    changed = False
    for candidate in release_root.iterdir():
        if ARCHIVE_TEMP_PATTERN.fullmatch(candidate.name) is None:
            continue
        metadata = os.lstat(candidate)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.geteuid():
            raise ValueError("模型 manifest 临时归档文件不安全")
        candidate.unlink()
        changed = True
    if changed:
        _fsync_directory(release_root)


def _read_archived_manifest(destination: Path) -> bytes:
    metadata = os.lstat(destination)
    if (
        stat.S_ISLNK(metadata.st_mode)
        or not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
        or stat.S_IMODE(metadata.st_mode) != 0o600
    ):
        raise ValueError("已归档 manifest 必须是当前用户拥有的 0600 普通文件")
    descriptor = os.open(destination, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        archived = bytearray()
        while chunk := os.read(descriptor, 1024 * 1024):
            archived.extend(chunk)
    finally:
        os.close(descriptor)
    return bytes(archived)


def _copy_manifest_once(source_bytes: bytes, destination: Path) -> None:
    release_root = destination.parent
    lock_descriptor = _open_archive_lock(release_root)
    temporary: Path | None = None
    try:
        fcntl.flock(lock_descriptor, fcntl.LOCK_EX)
        _cleanup_archive_temporaries(release_root)
        if destination.exists() or destination.is_symlink():
            if _read_archived_manifest(destination) != source_bytes:
                raise ValueError("同一 release tag 与 Git SHA 已存在不同的模型 manifest")
            return

        temporary = release_root / (
            f".{MANIFEST_NAME}.archive-{uuid.uuid4().hex}.tmp"
        )
        destination_fd = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
        )
        try:
            os.fchmod(destination_fd, 0o600)
            view = memoryview(source_bytes)
            while view:
                written = os.write(destination_fd, view)
                view = view[written:]
            os.fsync(destination_fd)
        finally:
            os.close(destination_fd)
        pause_marker = os.environ.get("REPORT_ARCHIVE_TEST_PAUSE_AFTER_TEMP_WRITE")
        if pause_marker:
            Path(pause_marker).write_text("paused", encoding="utf-8")
            while True:
                signal.pause()
        os.replace(temporary, destination)
        temporary = None
        _fsync_directory(release_root)
    finally:
        if temporary is not None and temporary.exists():
            temporary.unlink()
            _fsync_directory(release_root)
        fcntl.flock(lock_descriptor, fcntl.LOCK_UN)
        os.close(lock_descriptor)


def main() -> int:
    arguments = _parse_args()
    try:
        release_tag = _validate_component(
            arguments.release_tag, RELEASE_TAG_PATTERN, "release tag"
        )
        git_sha = _validate_component(arguments.git_sha, GIT_SHA_PATTERN, "Git SHA")
        manifest_bytes = (
            _read_private_manifest(arguments.external_manifest)
            if arguments.external_manifest is not None
            else None
        )
        restricted_candidate = arguments.restricted_root.absolute()
        if _inside_any_git_worktree(restricted_candidate):
            raise ValueError("restricted root 必须位于所有 Git 工作树外")
        reports_root = _require_private_root(arguments.reports_root, "reports root")
        restricted_root = _require_private_root(
            restricted_candidate, "restricted root"
        )
        if _paths_overlap(reports_root, restricted_root):
            raise ValueError("reports root 与 restricted root 不能互相包含")

        release_root = _ensure_private_tree(
            reports_root, "milestone-2b", "releases", release_tag, git_sha
        )
        for category in EVIDENCE_CATEGORIES:
            _ensure_private_tree(release_root, category)

        restricted_release = _ensure_private_tree(
            restricted_root, "milestone-2b", "releases", release_tag, git_sha
        )
        if manifest_bytes is not None:
            _copy_manifest_once(
                manifest_bytes,
                restricted_release / "model-assets.manifest.json",
            )
    except (OSError, ValueError) as error:
        print(f"准备报告目录失败: {error}", file=sys.stderr)
        return 2

    print(f"报告目录已准备: {release_root}")
    print(f"受限归档目录已准备: {restricted_release}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
